{
  "name": "sarahs-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "astro": "astro",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
