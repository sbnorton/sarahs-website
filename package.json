    "check": "astro check && eslint . && prettier --check .",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "^7.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261019.1": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.153.0"
  }
}
