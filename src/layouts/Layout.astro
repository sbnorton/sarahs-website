---
interface Props {
    title: string;
    description?: string;
    showNav?: boolean;
}
import "../styles/global.css";
import TopNav from "../components/topNav/TopNav";
import SiteFooter from "../components/siteFooter/SiteFooter.astro";

const { title, description, showNav = true } = Astro.props;

// 1. Get the current page route URL
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        {description && <meta name="description" content={description} />}
        <title>{title}</title>
    </head>
    <body>
        <!-- 2. Pass currentPath to TopNav & wrap in header to persist across navigation -->
        {showNav && (
            <header transition:persist>
                <TopNav currentPath={currentPath} client:load />
            </header>
        )}
        <slot />
        <SiteFooter />
    </body>
</html>