---
import SiteLayout from "../../layouts/Layout.astro";
import styles from "./page.module.css";
---

<SiteLayout title="About | Sarah Norton">
  <article class={styles.aboutPage}>
    <div class={styles.pageIntro}>
      <p class="eyebrow">About me</p>
      <h1 class="title">Sarah Norton.</h1>
      <p class="subtitle">Developer and photographer, based in Norway.</p>
    </div>

    <div class={styles.aboutCard}>
      <div class={styles.contentColumn}>
        <div>
          <h2 class={styles.hello}>Hi!</h2>
          <p class={styles.nameIntro}>
            <strong>I'm Sarah! </strong>
            <span class={styles.muted}>
              Here is a little more about me, the person behind this website:).</span
            >
          </p>
          <div class={styles.bio}>
            <p>
              I'm currently in my final year of a Master's Degree in Computer
              Science at NTNU. In high school, I majored in Media and
              Communication, and I like being creative, through everything from
              programming to photograpy.
            </p>
            <p>
              My projects range from mobile development and visual computing to
              brand, interface, and photographic work.
            </p>
              <p>
                Feel free to reach out if you have any questions!
              </p>
            <p class={styles.emphasis}>
              And no: I am not related to Graham Norton.
            </p>
          </div>
        </div>

        <div class={styles.cardFooter}>
          <div class={styles.divider}></div>
          <div class={styles.actions}>
            <a class={styles.cta} href="mailto:hello@sarahnorton.no"
              >Get in touch</a
            >
            <div class={styles.connect}>
              <p class={styles.connectLabel}>Find me on</p>
              <div class={styles.links}>
                <a href="https://github.com/sbnorton">GitHub</a>
                <a href="www.linkedin.com/in/sarah-norton-82905b310">LinkedIn</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class={styles.portrait}>
        <img
          src="/assets/svg/logo/sarahslogo-black.svg"
          alt="Sarah Norton logo"
        />
      </div>
    </div>
  </article>
</SiteLayout>
